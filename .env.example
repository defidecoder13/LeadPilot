# LeadPilot environment configuration.
#
# BROWSER-SAFE (NEXT_PUBLIC_*): these values are embedded in the client
# bundle. Only n8n webhook URLs belong here — never secrets, API keys,
# database URLs, or credentials.
NEXT_PUBLIC_N8N_LEAD_DISCOVERY_WEBHOOK_URL=
NEXT_PUBLIC_N8N_LEADS_WEBHOOK_URL=
NEXT_PUBLIC_N8N_RESEARCH_WEBHOOK_URL=
NEXT_PUBLIC_N8N_CONTACT_EMAIL_WEBHOOK_URL=
NEXT_PUBLIC_N8N_DRAFT_EMAIL_WEBHOOK_URL=
NEXT_PUBLIC_N8N_UPDATE_EMAIL_DRAFT_WEBHOOK_URL=
NEXT_PUBLIC_N8N_APPROVE_EMAIL_WEBHOOK_URL=
NEXT_PUBLIC_N8N_SEND_EMAIL_WEBHOOK_URL=
NEXT_PUBLIC_N8N_DELETE_LEADS_WEBHOOK_URL=

# SERVER-ONLY: read by scripts/db-migrate.mjs (node runtime).
# Never prefix with NEXT_PUBLIC_. Never commit a real value.
DATABASE_URL=

# N8N-ONLY (configured inside the n8n instance, not this repo):
# Google Places API key, Firecrawl API key, Gemini API key,
# Gmail OAuth2 credentials, Postgres credentials.
