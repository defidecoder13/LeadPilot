        "mode": "runOnceForAllItems",
        "jsCode": "const items = $input.all();\nconst requestedId = $('VALIDATE - Update Email Draft').first().json.lead_id;\nif (items.length === 0 || !items[0].json.id) {\n  return [{ json: { success: false, status: 'NOT_FOUND', lead_id: requestedId, message: 'No lead exists for the provided lead_id.' } }];\n}\nconst lead = items[0].json;\nif (lead.email_status === 'SENT') {\n  return [{ json: { success: false, status: 'EMAIL_ALREADY_SENT', lead_id: lead.id, email_status: 'SENT', message: 'Sent emails cannot be edited.' } }];\n}\nconst validated = $('VALIDATE - Update Email Draft').first().json;\nreturn [{ json: { success: true, status: 'READY', ...lead, email_subject: validated.email_subject, email_body: validated.email_body } }];"
