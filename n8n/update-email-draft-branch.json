        "mode": "runOnceForAllItems",
        "jsCode": "const body = $input.first().json.body ?? $input.first().json;\nconst leadId = String(body.lead_id ?? '').trim();\nconst subject = typeof body.email_subject === 'string' ? body.email_subject : '';\nconst emailBody = typeof body.email_body === 'string' ? body.email_body : '';\nconst uuidRe = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;\nif (!uuidRe.test(leadId)) {\n  return [{ json: { success: false, status: 'INVALID_LEAD_ID', message: 'lead_id must be a valid UUID.' } }];\n}\nif (!subject.trim()) {\n  return [{ json: { success: false, status: 'INVALID_SUBJECT', message: 'email_subject must not be empty.' } }];\n}\nif (!emailBody.trim()) {\n  return [{ json: { success: false, status: 'INVALID_BODY', message: 'email_body must not be empty.' } }];\n}\nreturn [{ json: { success: true, status: 'VALID', lead_id: leadId, email_subject: subject.trim(), email_body: emailBody } }];"
      },
